<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TcoInstaller.MainWindow"
        Title="TCO Installer"
        Width="760"
        Height="760"
        MinWidth="680"
        MinHeight="680"
        Background="#0B0E14"
        WindowStartupLocation="CenterScreen">
  <Grid RowDefinitions="Auto,*">
    <Border Padding="28,24" Background="#111522" BorderBrush="#252C3B" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="5">
          <TextBlock Text="TCO" FontSize="13" FontWeight="Bold" Foreground="#9B87FF" />
          <TextBlock Text="TERA Complete installer" FontSize="26" FontWeight="SemiBold" />
          <TextBlock Text="Engine profile · DXVK · ReShade" Foreground="#929BAE" />
        </StackPanel>
        <Border Grid.Column="1" Padding="12,7" CornerRadius="20" Background="#1B2130" VerticalAlignment="Center">
          <TextBlock Text="{Binding StatusText}" Foreground="#C8D0E0" FontSize="12" />
        </Border>
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1">
      <StackPanel Margin="28" Spacing="16">
        <Border Classes="card">
          <StackPanel Spacing="14">
            <TextBlock Text="Installation" FontSize="17" FontWeight="SemiBold" />

            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="6">
              <TextBlock Text="TERA directory" Foreground="#AAB3C4" />
              <TextBox Grid.Row="1"
                       Text="{Binding TeraRoot, Mode=TwoWay}"
                       PlaceholderText="Select the folder containing Binaries and S1Game" />
              <Button Grid.Row="1" Grid.Column="1" Content="Browse…" Click="Browse_OnClick" Padding="18,0" />
            </Grid>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
              <StackPanel Spacing="6">
                <TextBlock Text="Action" Foreground="#AAB3C4" />
                <ComboBox ItemsSource="{Binding Actions}" SelectedItem="{Binding SelectedAction, Mode=TwoWay}" />
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="9" Margin="0,3,0,0">
                <CheckBox Content="Check GitHub for updates"
                          IsChecked="{Binding CheckForUpdates, Mode=TwoWay}"
                          IsEnabled="{Binding CanCheckForUpdates}" />
                <CheckBox Content="Configure TCC and Shinra"
                          IsChecked="{Binding IncludeClassicPlus, Mode=TwoWay}"
                          IsEnabled="{Binding CanIncludeClassicPlus}" />
              </StackPanel>
            </Grid>

            <Button Classes="primary"
                    Content="{Binding RunButtonText}"
                    IsEnabled="{Binding CanRun}"
                    Click="Run_OnClick"
                    HorizontalAlignment="Stretch" />

            <TextBlock Text="The installer requests administrator access only when the selected action changes files."
                       Foreground="#778197" FontSize="11" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <Border Classes="card">
          <StackPanel Spacing="14">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="Progress" FontSize="17" FontWeight="SemiBold" />
              <ProgressBar Grid.Column="1" Width="120" Height="4" IsIndeterminate="{Binding IsRunning}" />
            </Grid>

            <ItemsControl ItemsSource="{Binding Phases}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Rows="1" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel HorizontalAlignment="Center" Spacing="6">
                    <Border Width="25" Height="25" CornerRadius="13" Background="{Binding StatusBrush}">
                      <TextBlock Text="{Binding StatusGlyph}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 FontWeight="Bold" />
                    </Border>
                    <TextBlock Text="{Binding Label}" Foreground="#AAB3C4" FontSize="11" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <Border Classes="card">
          <Grid RowDefinitions="Auto,*" RowSpacing="12">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="Live output" FontSize="17" FontWeight="SemiBold" />
              <Button Grid.Column="1" Content="Open log" IsEnabled="{Binding HasLog}" Click="OpenLog_OnClick" />
            </Grid>
            <TextBox x:Name="LogTextBox"
                     Grid.Row="1"
                     Height="190"
                     Text="{Binding LogText}"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="NoWrap"
                     FontFamily="Cascadia Mono, Consolas"
                     FontSize="11"
                     Background="#090C12"
                     BorderBrush="#202738"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto" />
          </Grid>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
